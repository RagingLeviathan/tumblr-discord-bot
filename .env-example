# Discord bot token (despite the variable's name, this is the bot token)
DISCORD_CLIENT_SECRET=your_discord_bot_token

# Tumblr application credentials
CONSUMER_KEY=your_tumblr_consumer_key
CONSUMER_SECRET=your_tumblr_consumer_secret

# Tumblr OAuth 1.0a user credentials, used for follower retrieval
OAUTH_KEY=your_tumblr_oauth_token
OAUTH_SECRET=your_tumblr_oauth_token_secret